# Lisa Backend Environment Template

# Application Info
PROJECT_NAME="Lisa - AI Content Distribution & Repurposing Platform"
VERSION="1.0.0"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Security & JWT Tokens
SECRET_KEY="replace_with_a_secure_random_64_character_hex_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# Database Configuration
# SQLite (Local Dev):
DATABASE_URL="sqlite+aiosqlite:///./lisa.db"
# PostgreSQL (Production):
# DATABASE_URL="postgresql+asyncpg://lisa_user:lisa_password@localhost:5432/lisa_db"

# Redis Queue
REDIS_URL="redis://localhost:6379/0"

# Media Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=50

# Optional: External LLM API Keys
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# Optional: Platform OAuth Credentials
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
X_API_KEY=""
X_API_SECRET=""
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
